# Run python scripts/init_env.py to generate local secrets without printing them.
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./switchops.db
POSTGRES_PASSWORD=REPLACE_WITH_DB_PASSWORD
REDIS_URL=redis://localhost:6379/0
APP_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
APP_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
# Official Switch Console stack runs separately. Never use the registration key as an agent key.
SWITCH_SERVER_URL=
SWITCH_REGISTRATION_KEY=
# Room IDs and human participant mappings are configured per organization in Settings.
MODEL_PROVIDER=ollama
MODEL_BASE_URL=http://localhost:11434
MODEL_NAME=qwen3:8b
MODEL_API_KEY=
# For Gemini: MODEL_PROVIDER=gemini, MODEL_NAME=gemini-3.5-flash-lite,
# MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Set explicit consent only for data authorized to leave your machine.
MODEL_ALLOW_EXTERNAL_PRIVATE_DATA=false
MAX_HANDOFFS=16
MAX_MODEL_CALLS=16
HANDOFF_TIMEOUT_SECONDS=900
SESSION_HOURS=12
# Disabled until configured. Docker Compose uses Mailpit on the internal network.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=switchops@example.test
SMTP_SANDBOX=true
SMTP_STARTTLS=false
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=switchops
MINIO_SECRET_KEY=REPLACE_WITH_MINIO_PASSWORD
MINIO_BUCKET=switchops-private
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback
EMBEDDINGS_ENABLED=false
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
